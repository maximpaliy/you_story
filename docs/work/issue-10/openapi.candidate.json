{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "LogoutForm": {
        "additionalProperties": false,
        "properties": {
          "csrf": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          }
        },
        "required": [
          "csrf"
        ],
        "type": "object"
      },
      "OwnProfile": {
        "additionalProperties": false,
        "properties": {
          "provisioning_state": {
            "enum": [
              "catalog_pending",
              "ready"
            ],
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "provisioning_state"
        ],
        "type": "object"
      },
      "StartGoogleLogin": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "default": "home",
            "enum": [
              "home",
              "calendar",
              "catalog"
            ],
            "type": "string"
          },
          "invitation": {
            "maxLength": 43,
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "proof": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "proof"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "description": "Opaque Secure HttpOnly SameSite=Lax host-only session. No URL/body/header authentication.",
