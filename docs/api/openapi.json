{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "OwnProfile": {
        "additionalProperties": false,
        "properties": {
          "provisioning_state": {
            "enum": [
              "catalog_pending",
              "ready"
            ],
            "title": "Provisioning State",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "provisioning_state"
        ],
        "title": "OwnProfile",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "description": "Opaque browser session; request fields cannot select identity or tenant.",
        "in": "cookie",
        "name": "__Host-you_story_session",
        "type": "apiKey"
      }
    }
  },
