    "/auth/google/callback": {
      "get": {
        "description": "Exactly one state and one of code or error. Unknown/duplicate query fields and body rejected. HEAD never dispatches; every GET failure is generic HTML.",
        "operationId": "completeGoogleLogin",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "authuser",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "prompt",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "iss",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error_description",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error_uri",
            "required": false,
            "schema": {
              "maxLength": 8192,
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Generic sign-in failure with fixed /login retry link"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Method not allowed"
          },
          "409": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Generic sign-in failure with fixed /login retry link"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "429": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Generic sign-in failure with fixed /login retry link",
            "headers": {
              "Retry-After": {
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Generic sign-in failure with fixed /login retry link"
          },
          "503": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Generic sign-in failure with fixed /login retry link"
          }
        },
        "summary": "Callback",
        "x-max-query-bytes": 8192,
        "x-reject-duplicate-fields": true
      }
    },
    "/auth/google/start": {
      "post": {
        "operationId": "startGoogleLogin",
